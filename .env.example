# Supabase Configuration
# Replace with your actual Supabase project credentials

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: 
# - SUPABASE_URL: Found in Project Settings > API
# - SUPABASE_ANON_KEY: Found in Project Settings > API (anon public)
# - SUPABASE_SERVICE_ROLE_KEY: Found in Project Settings > API (service_role)
#   WARNING: Never expose the service role key in client-side code!
